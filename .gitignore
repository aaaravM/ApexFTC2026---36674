# Built application files
*.apk
*.aar
*.ap_
*.aab

!libs/*.aar

# Files for the ART/Dalvik VM
*.dex

# Java/JDK files
*.class
*.hprof

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# ---------------------------------------------------------------------------------------------
# VS Code / Cursor -- added for this team, since we work across several computers.
#
# NOTE we do NOT ignore .vscode/ wholesale: settings.json and extensions.json are committed on
# purpose so every machine gets the same IntelliSense configuration and extension prompts. Only
# the per-machine files below are ignored.
# ---------------------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/README.md

# Eclipse JDT language-server project state, written by the VS Code / Cursor Java extension.
# By default these go to the extension's workspace storage rather than the working tree
# (java.import.generatesMetadataFilesAtProjectRoot defaults to false), but there are known cases
# where that is not honoured, and .classpath and .factorypath can contain absolute machine paths.
# Cheap insurance.
.project
.classpath
.factorypath
.settings/

# Staged dependency jars for IntelliSense. Generated, machine-specific, and large.
.ide-libs/

# Claude Code's per-session working directory. Machine-specific, not project content.
.claude/

# For Mac users
.DS_Store

# Keystore files
# Uncomment the following lines if you do not want to check your keystore files in.
#*.jks
#*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/